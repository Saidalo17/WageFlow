# Turso database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth.js (random string, 32+ bytes: npx auth secret)
AUTH_SECRET=
# Production base URL (not needed in dev)
AUTH_URL=

# Email for "forgot password" (any SMTP provider; for Gmail use an App Password)
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to the user, e.g. Salary <you@gmail.com>
MAIL_FROM=
